{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: Widget Preview",
      "type": "shell",
      "command": "flutter",
      "args": ["widget-preview", "start"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter: Widget Preview Clean",
      "type": "shell",
      "command": "flutter",
      "args": ["widget-preview", "clean"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
